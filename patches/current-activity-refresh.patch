+import type { JsonRpcProvider, TransactionReceipt, TransactionResponse } from 'ethers'
+
+/** Optional budget for individual receipt and transaction lookups during an activity refresh. */
+export interface ActivityLookupOptions {
+  timeoutMs?: number
+  maxResultAgeMs?: number
+}
+
+/** A lookup timeout leaves the submitted transaction unresolved. */
+export class ActivityLookupTimeoutError extends Error {
+  constructor() {
+    super('Transaction status is not available yet. It will be checked again.')
+    this.name = 'ActivityLookupTimeoutError'
+  }
+}
+
+interface LookupWaiter<T> {
+  settle: (outcome: LookupOutcome<T>) => boolean
+  expire: () => void
+}
+
+type LookupOutcome<T> = { ok: true; value: T } | { ok: false; error: unknown }
+
+interface LookupEntry<T> {
+  waiters: Set<LookupWaiter<T>>
+  outcome?: LookupOutcome<T>
+  completedAt?: number
+  expiryTimer?: ReturnType<typeof setTimeout>
+  released: boolean
+  clear: () => void
+}
+
+type Provider = Pick<JsonRpcProvider, 'getTransactionReceipt' | 'getTransaction'>
+
+/**
+ * Opt-in deadlines around existing providers. A timeout does not cancel the
+ * transport. Reuse an outstanding lookup across refreshes until it settles so
+ * a shorter activity budget does not multiply requests to a slow provider.
+ */
+export class ActivityLookups {
+  #timeoutMs: number | undefined
+
+  #maxResultAgeMs: number
+
+  #receipts = new WeakMap<Provider, Map<string, LookupEntry<TransactionReceipt | null>>>()
+
+  #transactions = new WeakMap<Provider, Map<string, LookupEntry<TransactionResponse | null>>>()
+
+  #releaseLookups = new Set<() => void>()
+
+  #disposed = false
+
+  constructor({ timeoutMs, maxResultAgeMs = 30_000 }: ActivityLookupOptions = {}) {
+    if (
+      timeoutMs !== undefined &&
+      (!Number.isInteger(timeoutMs) || timeoutMs < 1 || timeoutMs > 2_147_483_647)
+    ) {
+      throw new RangeError(
+        'Choose a whole-number lookup timeout between 1 and 2147483647 milliseconds.'
+      )
+    }
+    if (!Number.isInteger(maxResultAgeMs) || maxResultAgeMs < 1 || maxResultAgeMs > 2_147_483_647) {
+      throw new RangeError(
+        'Choose a whole-number result age between 1 and 2147483647 milliseconds.'
+      )
+    }
+    this.#timeoutMs = timeoutMs
+    this.#maxResultAgeMs = maxResultAgeMs
+  }
+
+  getReceipt(provider: Provider, txnId: string): Promise<TransactionReceipt | null> {
+    return this.#lookup(provider, txnId, this.#receipts, () =>
+      provider.getTransactionReceipt(txnId)
+    )
+  }
+
+  getTransaction(provider: Provider, txnId: string): Promise<TransactionResponse | null> {
+    return this.#lookup(provider, txnId, this.#transactions, () => provider.getTransaction(txnId))
+  }
+
+  /** Release owned waiters and lookup metadata; the provider still owns in-flight requests. */
+  dispose() {
+    this.#disposed = true
+    for (const release of Array.from(this.#releaseLookups)) release()
+  }
+
+  #lookup<T>(
+    provider: Provider,
+    txnId: string,
+    cache: WeakMap<Provider, Map<string, LookupEntry<T>>>,
+    request: () => Promise<T>
+  ): Promise<T> {
+    // Preserve existing behavior when no activity budget was selected.
+    if (this.#timeoutMs === undefined) return request()
+    if (this.#disposed) return Promise.reject(new ActivityLookupTimeoutError())
+
+    let byTxnId = cache.get(provider)
+    if (!byTxnId) {
+      byTxnId = new Map()
+      cache.set(provider, byTxnId)
+    }
+    const key = txnId.toLowerCase()
+    let entry = byTxnId.get(key)
+    if (entry?.outcome && entry.completedAt !== undefined) {
+      const outcome = entry.outcome
+      const isFresh = performance.now() - entry.completedAt < this.#maxResultAgeMs
+      entry.clear()
+      if (isFresh)
+        return outcome.ok ? Promise.resolve(outcome.value) : Promise.reject(outcome.error)
+      entry = undefined
+      // clear() may remove the empty provider map. Register it again for a new lookup.
+      cache.set(provider, byTxnId)
+    }
+    if (!entry) {
+      const capturedMap = byTxnId
+      const clear = () => {
+        captured.released = true
+        clearTimeout(captured.expiryTimer)
+        if (capturedMap.get(key) === captured) capturedMap.delete(key)
+        if (capturedMap.size === 0) cache.delete(provider)
+        this.#releaseLookups.delete(release)
+      }
+      const release = () => {
+        clear()
+        for (const waiter of captured.waiters) waiter.expire()
+        captured.waiters.clear()
+      }
+      const captured: LookupEntry<T> = { waiters: new Set(), released: false, clear }
+      entry = captured
+      byTxnId.set(key, entry)
+      this.#releaseLookups.add(release)
+      const settle = (outcome: LookupOutcome<T>) => {
+        if (captured.released) return
+        let deliveredWithinBudget = false
+        for (const waiter of captured.waiters) {
+          if (waiter.settle(outcome)) deliveredWithinBudget = true
+        }
+        captured.waiters.clear()
+        if (deliveredWithinBudget) {
+          clear()
+        } else {
+          // Also retain answers when an event-loop delay left an expired waiter
+          // in the set. No late continuation may mutate Activity outside a refresh.
+          captured.outcome = outcome
+          captured.completedAt = performance.now()
+          captured.expiryTimer = setTimeout(clear, this.#maxResultAgeMs)
+        }
+      }
+      // Attach one settlement handler per underlying request. Expired refresh
+      // waiters are removed from the set, not retained as Promise.race reactions.
+      Promise.resolve()
+        .then(() => {
+          if (captured.released || this.#disposed) throw new ActivityLookupTimeoutError()
+          return request()
+        })
+        .then(
+          (value) => settle({ ok: true, value }),
+          (error: unknown) => settle({ ok: false, error })
+        )
+    }
+    return this.#waitForEntry(entry, this.#timeoutMs)
+  }
+
+  #waitForEntry<T>(entry: LookupEntry<T>, timeoutMs: number): Promise<T> {
+    const started = performance.now()
+    return new Promise<T>((resolve, reject) => {
+      const finish = () => {
+        clearTimeout(timer)
+        entry.waiters.delete(waiter)
+      }
+      const waiter: LookupWaiter<T> = {
+        settle: (outcome) => {
+          const withinBudget = performance.now() - started < timeoutMs
+          finish()
+          if (!withinBudget) reject(new ActivityLookupTimeoutError())
+          else if (outcome.ok) resolve(outcome.value)
+          else reject(outcome.error)
+          return withinBudget
+        },
+        expire: () => {
+          finish()
+          reject(new ActivityLookupTimeoutError())
+        }
+      }
+      const timer = setTimeout(() => waiter.expire(), timeoutMs)
+      entry.waiters.add(waiter)
+    })
+  }
+}
